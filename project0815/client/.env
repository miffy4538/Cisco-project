# ===================================================================
# ローカルで `npm run dev` / `npm run build` する際に読み込まれる環境変数。
# Vite の仕様により、ここに書いた値はビルド時にそのままJSバンドルに埋め込まれる
# (=ブラウザから見える)ため、そもそも埋め込んでよい値(ユーザープール/クライアント/
# アイデンティティプールのID、APIのURL、リージョンなど)しか置いていない。
#
# 【重要】この中に絶対にパスワードなどの秘密情報を書かないこと。
# テスト用ユーザーのパスワードはこのファイルにもリポジトリ内のどこにも書いていない。
# ログインフォームから人が手入力してテストする用途のみを想定している
# (Amplifyの signIn() は実行時の引数としてパスワードを渡すだけで、
# どこにも保存・埋め込みしないため、.envに書く必要が無い)。
#
# Docker/restart.bat経由で動かす場合はこのファイルは使われない
# (ルート直下の .env / docker-compose.yml のビルド引数経由で渡される。
# 詳細は ../.env.example と ../docker-compose.yml を参照)。
# ===================================================================

# --- AWS Cognito (Step 1: 認証) ---
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_VOqJJhoce
VITE_COGNITO_CLIENT_ID=53cvlrgu3dgvcs6ur64c735on6
VITE_COGNITO_IDENTITY_POOL_ID=ap-southeast-1:210ac09d-2d6a-47bd-b37c-6a66c7fcd2fa

# --- AWS IoT Core (Step 3: MQTT over WebSocket、現状は準備のみ・未接続) ---
VITE_IOT_ENDPOINT=a3evuy0mh0c3lq-ats.iot.ap-southeast-1.amazonaws.com

# --- 履歴取得API (Step 5、モックAPI) ---
VITE_HISTORY_API_URL=https://mdaiocmem7.execute-api.ap-southeast-1.amazonaws.com/history

# 見守りサーバー(Node.js)への接続先。ローカル `npm run dev` 時は既定値(localhost:3001)を使う。
# VITE_SOCKET_URL=
